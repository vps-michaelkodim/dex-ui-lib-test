{
  "name": "@dextinity/storybook",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:visual": "vitest run -c vitest.visual.config.ts",
    "test:visual:update": "vitest run -c vitest.visual.config.ts --update"
  },
  "dependencies": {
    "@dextinity/icons": "workspace:*",
    "@dextinity/tokens": "workspace:*",
    "@dextinity/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-designs": "~11.1.4",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
